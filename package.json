{
  "name": "onur.dev",
  "description": "My personal website.",
  "author": {
    "name": "Onur Şuyalçınkaya",
    "url": "https://onur.dev"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "generate:og": "node scripts/generate-og.mjs",
    "prebuild": "node scripts/generate-og.mjs || echo \"warning: reusing committed OG images\"",
    "postinstall": "node scripts/patch-opennext-og-worker.mjs",
    "build": "next build",
    "start": "next start",
    "preview:cloudflare": "NEXT_PRIVATE_STANDALONE=true NEXT_PRIVATE_OUTPUT_TRACE_ROOT=\"$(npm prefix)\" npm run build && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare preview",
    "deploy:cloudflare": "NEXT_PRIVATE_STANDALONE=true NEXT_PRIVATE_OUTPUT_TRACE_ROOT=\"$(npm prefix)\" npm run build && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare deploy",
    "prettier": "prettier --write \"**/*.{html,js,json,md,mdx,mjs}\"",
    "clear-cache": "rm -rf .next",
    "unused": "next-unused",
    "lint": "eslint src --ext js"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.0.2",
    "@supabase/supabase-js": "^2.26.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "class-variance-authority": "^0.6.1",
    "classix": "^2.1.34",
    "cssnano": "^6.0.0",
    "encoding": "^0.1.13",
    "eslint-config-next": "^16.3.8",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.279.0",
    "markdown-to-jsx": "^7.2.1",
    "next": "^16.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^9.4.3",
    "react-syntax-highlighter": "^16.1.1",
    "react-tweet": "^3.0.3",
    "react-wrap-balancer": "^0.4.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.6",
    "vaul": "^0.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "autoprefixer": "^10.4.14",
    "bun": "^1.4.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-react": "^7.32.2",
    "next-unused": "^0.0.6",
    "postcss": "^8.5.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.3.3",
    "wrangler": "^4.147.0"
  },
  "next-unused": {
    "debug": true,
    "entrypoints": [
      "src"
    ]
  }
}
