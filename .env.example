# Contentful CMS (optional; now only used for static pages and logbook entries)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_SECRET=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Supabase (required for /admin, posts, projects and likes)
# Run supabase/portfolio.sql in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Admin CMS authentication (required for /admin)
# Any password you like. Must match what you type on /admin/login.
ADMIN_PASSWORD=
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs the session cookie.
ADMIN_SESSION_SECRET=

# Contact-form email notifications (optional; Resend free tier)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=

# Raindrop bookmarks (optional; keep this server-side)
RAINDROP_ACCESS_TOKEN=

# On-demand revalidation
NEXT_REVALIDATE_SECRET=

# Tinybird analytics (optional)
NEXT_PUBLIC_TINYBIRD_TOKEN=

# Canonical public website URL after you choose a domain (optional until launch)
NEXT_PUBLIC_SITE_URL=https://antonkuz.com